# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'CreativeBridge' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    # Disable New Architecture for compatibility with RN 0.81.1
    :new_arch_enabled => false
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    
    # Fix for Xcode 26+ compatibility with React Native 0.81.1
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Use C++20 for all React Native modules but with compatibility flags
        if target.name.start_with?('React') || target.name.include?('ReactCommon') || target.name.start_with?('RN') || target.name.include?('react-native')
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
          # Add compatibility flags for newer C++ standards
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] ||= '$(inherited)'
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] << ' -Wno-unknown-pragmas -Wno-unguarded-availability -Wno-deprecated'
        end
        
        # Ensure C++ standard library is properly linked
        config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
        
        # Add comprehensive header search paths
        config.build_settings['HEADER_SEARCH_PATHS'] ||= '$(inherited)'
        config.build_settings['HEADER_SEARCH_PATHS'] << ' /Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimulator.platform/Developer/SDKs/iPhoneSimulator.sdk/usr/include'
        config.build_settings['HEADER_SEARCH_PATHS'] << ' /Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimulator.platform/Developer/SDKs/iPhoneSimulator.sdk/usr/include/c++/v1'
        config.build_settings['HEADER_SEARCH_PATHS'] << ' /Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/include/c++/v1'
        
        # Enable modules and C++ modules
        config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
        config.build_settings['CLANG_ENABLE_MODULE_DEBUGGING'] = 'YES'
        config.build_settings['CLANG_MODULES_AUTOLINK'] = 'YES'
        
        # Force standard library modules to be available
        config.build_settings['CLANG_MODULES_DISABLE_PRIVATE_WARNING'] = 'YES'
        
        # Explicitly add system framework search paths
        config.build_settings['SYSTEM_HEADER_SEARCH_PATHS'] ||= '$(inherited)'
        config.build_settings['SYSTEM_HEADER_SEARCH_PATHS'] << ' /Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimulator.platform/Developer/SDKs/iPhoneSimulator.sdk/usr/include'
        config.build_settings['SYSTEM_HEADER_SEARCH_PATHS'] << ' /Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/include'
        
        # Additional compatibility settings
        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        config.build_settings['CLANG_WARN_DOCUMENTATION_COMMENTS'] = 'NO'
        
        # Ensure SystemConfiguration framework is linked for netinfo
        if target.name.include?('react-native-netinfo')
          config.build_settings['OTHER_LDFLAGS'] ||= '$(inherited)'
          config.build_settings['OTHER_LDFLAGS'] << ' -framework SystemConfiguration'
        end
        
        # Fix deployment target warnings
        config.build_settings.delete 'IPHONEOS_DEPLOYMENT_TARGET'
      end
    end
  end
end
