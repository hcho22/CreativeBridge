{
  "name": "CreativeBridge",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "test": "jest",
    "generate-icons": "node scripts/generate-app-icons.js",
    "generate-android-icons": "node scripts/generate-android-icons.js",
    "generate-all-assets": "npm run generate-icons && npm run generate-android-icons",
    "install-sharp": "npm install sharp",
    "setup-icons": "npm run install-sharp && npm run generate-all-assets",
    "build:ios": "scripts/build-ios.sh",
    "build:ios:simulator": "scripts/build-ios.sh --simulator",
    "build:android": "scripts/build-android.sh",
    "build:android:debug": "scripts/build-android.sh --debug",
    "build:android:apk": "scripts/build-android.sh --apk",
    "build:android:bundle": "scripts/build-android.sh --bundle",
    "build:all": "npm run build:ios && npm run build:android",
    "eas:build:development": "eas build --profile development",
    "eas:build:preview": "eas build --profile preview",
    "eas:build:production": "eas build --profile production",
    "eas:build:ios": "eas build --platform ios",
    "eas:build:android": "eas build --platform android",
    "eas:update": "eas update",
    "eas:update:preview": "eas update --branch preview",
    "eas:update:production": "eas update --branch production",
    "prepare": "husky",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "deploy:image-generation": "node scripts/deploy-production.js",
    "deploy:staging": "npm run deploy:image-generation -- --stage=staging --percentage=25",
    "deploy:production": "npm run deploy:image-generation -- --stage=production --percentage=25",
    "rollback:image-generation": "npx ts-node scripts/rollback-image-generation.ts",
    "test:image-generation": "jest --testPathPattern=imageGeneration",
    "test:image-generation-models": "npx ts-node scripts/test-image-generation-new-models.ts",
    "test:image-generation-simple": "node scripts/test-image-generation-simple.js",
    "test:claude-skills": "jest --testPathPattern=claudeSkills",
    "test:claude-skills-integration": "jest --testPathPattern=integration/claudeSkills",
    "validate:database": "npx ts-node scripts/validate-database-migrations.ts",
    "monitor:image-generation": "node scripts/monitor-rollout.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-voice/voice": "^3.2.4",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.8",
    "@supabase/supabase-js": "^2.57.4",
    "dotenv": "^17.2.3",
    "expo": "~54.0.25",
    "expo-updates": "^29.0.13",
    "openai": "^6.0.0",
    "pako": "^2.1.0",
    "react": "19.1.0",
    "react-hook-form": "^7.63.0",
    "react-native": "0.81.1",
    "react-native-async-storage": "^0.0.1",
    "react-native-device-info": "^14.1.1",
    "react-native-document-picker": "^9.3.1",
    "react-native-dotenv": "^3.4.11",
    "react-native-fast-image": "^8.6.3",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-image-zoom-viewer": "^3.0.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-keychain": "^8.1.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-permissions": "^5.4.2",
    "react-native-reanimated": "^3.19.3",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.16.0",
    "react-native-share": "^12.2.0",
    "react-native-tts": "^4.1.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-vector-icons": "^10.3.0",
    "replicate": "^1.2.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@expo/metro-config": "^54.0.9",
    "@react-native-community/cli": "^20.0.2",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.1",
    "@react-native/eslint-config": "0.81.1",
    "@react-native/metro-config": "0.81.1",
    "@react-native/typescript-config": "0.81.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "^54.0.7",
    "eas-cli": "^16.28.0",
    "eslint": "^8.19.0",
    "expo": "^54.0.25",
    "expo-dev-client": "^6.0.18",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^16.2.1",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "reactotron-react-native": "^5.1.16",
    "sharp": "^0.34.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
