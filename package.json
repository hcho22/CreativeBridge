{
  "name": "CreativeBridge",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "generate-icons": "node scripts/generate-app-icons.js",
    "generate-android-icons": "node scripts/generate-android-icons.js",
    "generate-all-assets": "npm run generate-icons && npm run generate-android-icons",
    "install-sharp": "npm install sharp",
    "setup-icons": "npm run install-sharp && npm run generate-all-assets",
    "build:ios": "scripts/build-ios.sh",
    "build:ios:simulator": "scripts/build-ios.sh --simulator",
    "build:android": "scripts/build-android.sh",
    "build:android:debug": "scripts/build-android.sh --debug",
    "build:android:apk": "scripts/build-android.sh --apk",
    "build:android:bundle": "scripts/build-android.sh --bundle",
    "build:all": "npm run build:ios && npm run build:android",
    "prepare": "husky",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-voice/voice": "^3.2.4",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.8",
    "@supabase/supabase-js": "^2.57.4",
    "openai": "^6.0.0",
    "react": "19.1.0",
    "react-hook-form": "^7.63.0",
    "react-native": "0.81.1",
    "react-native-async-storage": "^0.0.1",
    "react-native-device-info": "^14.1.1",
    "react-native-document-picker": "^9.3.1",
    "react-native-fast-image": "^8.6.3",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.16.0",
    "react-native-tts": "^4.1.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-vector-icons": "^10.3.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.0.2",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.1",
    "@react-native/eslint-config": "0.81.1",
    "@react-native/metro-config": "0.81.1",
    "@react-native/typescript-config": "0.81.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^16.2.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "reactotron-react-native": "^5.1.16",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
