# Generated by `npx convex dev` / `convex codegen` — these files carry
# their own /* eslint-disable */ header. Keep ESLint out of them entirely
# so its --fix doesn't strip the directive on commit.
convex/_generated/

# Auto-generated Jest coverage reports — third-party JS files (prettify.js,
# sorter.js) carry their own /* eslint-disable */ headers from istanbul.
coverage/
