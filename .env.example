# CreativeBridge Environment Configuration
# Copy this to .env and fill in your actual values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Convex Configuration (PRIMARY for OAuth users)
# Get this from your Convex dashboard after running: npx convex dev
CONVEX_URL=https://your-project.convex.cloud

# Supabase Configuration (FALLBACK for email/password users)
# Migration Status (US-032): Supabase remains as fallback for:
# - Legacy email/password users without Clerk IDs
# - Fallback when Convex auth is unavailable
# Get these from your Supabase project dashboard
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenAI API Configuration (Required for AI story generation)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model (defaults to gpt-4o-mini if not set)
# Override to use a different model (e.g., gpt-4o, gpt-4-turbo)
OPENAI_MODEL=gpt-4o-mini

# OpenAI Organization ID (Required for COPPA compliance — US-017)
# Ensures org-level data policies (training opt-out) apply to all API calls.
# Find your org ID at: https://platform.openai.com/account/organization
OPENAI_ORG_ID=your_openai_org_id_here

# App Configuration
APP_NAME=CreativeBridge
APP_VERSION=1.0.0

# Image Generation Configuration (Story Image Generation Feature)
# Primary service: sebastianbodza/flux_aquarell_watercolor_style (Flux Aquarell) on Replicate
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Backup service: stability-ai/stable-diffusion-3.5-large (SD 3.5) on Replicate
# Can use same token as primary since both services are on Replicate platform
BACKUP_IMAGE_API_TOKEN=your_backup_api_token_here

# Feature flag for gradual rollout (false = disabled, true = enabled)
IMAGE_GENERATION_ENABLED=false

# Image Generation Settings
IMAGE_GENERATION_TIMEOUT_PRIMARY=60000
IMAGE_GENERATION_TIMEOUT_BACKUP=45000
IMAGE_GENERATION_MAX_CONCURRENT=10
IMAGE_GENERATION_XP_COST=1000

# COPPA Compliance Configuration (US-002)
# Resend API key for transactional consent emails
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Email sender address for consent emails
CONSENT_EMAIL_FROM=CreativeBridge <consent@creativebridge.app>

# Convex site URL for consent verification web page
# Set automatically by Convex — format: https://your-project.convex.site
# CONVEX_SITE_URL=https://your-project.convex.site

# Testing Configuration
# Set to 'true' to disable XP costs during development/testing
DISABLE_XP_COSTS_FOR_TESTING=false

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================

# To get Convex credentials:
# 1. Run: npx convex dev
# 2. Follow prompts to create/connect a Convex project
# 3. CONVEX_URL will be automatically set in .env.local

# To get Supabase credentials (only needed for legacy user support):
# 1. Go to https://supabase.com/dashboard
# 2. Select your project
# 3. Go to Settings > API
# 4. Copy the URL and anon/public key

# To get Replicate API token:
# 1. Go to https://replicate.com/account/api-tokens
# 2. Create a new token
# 3. Copy the token (format: r8_...)