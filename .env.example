# CreativeBridge Environment Configuration
# Copy this to .env and fill in your actual values

# Supabase Configuration
# Get these from your Supabase project dashboard
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenAI API Configuration (Required for AI story generation)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs Voice AI (Optional)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# App Configuration
APP_NAME=CreativeBridge
APP_VERSION=1.0.0

# Image Generation Configuration (Story Image Generation Feature)
# Primary service: stability-ai/stable-diffusion-3.5-large on Replicate
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Backup service: google/nano-banana (also uses Replicate)
# Can use same token as primary since both services are on Replicate platform
BACKUP_IMAGE_API_TOKEN=your_backup_api_token_here

# Feature flag for gradual rollout (false = disabled, true = enabled)
IMAGE_GENERATION_ENABLED=false

# Image Generation Settings
IMAGE_GENERATION_TIMEOUT_PRIMARY=60000
IMAGE_GENERATION_TIMEOUT_BACKUP=45000
IMAGE_GENERATION_MAX_CONCURRENT=10
IMAGE_GENERATION_XP_COST=1000

# Testing Configuration
# Set to 'true' to disable XP costs during development/testing
DISABLE_XP_COSTS_FOR_TESTING=false

# Example Supabase URL format:
# SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
# 
# To get your credentials:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project
# 3. Go to Settings > API
# 4. Copy the URL and anon/public key
#
# To get Replicate API token:
# 1. Go to https://replicate.com/account/api-tokens
# 2. Create a new token
# 3. Copy the token (format: r8_...)