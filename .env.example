# Supabase Configuration (Production Only)
# For development, update src/services/supabase.ts directly
# For production, set these environment variables
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OpenAI API Configuration (Required for AI story generation)
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs Voice AI (Optional)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# App Configuration
APP_NAME=CreativeBridge
APP_VERSION=1.0.0

# Example Supabase URL format:
# SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
# 
# To get your credentials:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project
# 3. Go to Settings > API
# 4. Copy the URL and anon/public key